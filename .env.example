UPSTREAM_BASE_URL=http://localhost:9000/v1   # real: https://api.openai.com/v1
UPSTREAM_API_KEY=                            # empty = forward client's Authorization
UPSTREAM_MODEL_OVERRIDE=                     # empty = pass client's model
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=300
NER_ENABLED=true
NER_MODEL=urchade/gliner_small-v2.1
NER_THRESHOLD=0.5
NER_TIMEOUT_MS=2000
# torch (default) or onnx; export first: uv run python scripts/export_ner_onnx.py
NER_RUNTIME=torch
NER_ONNX_DIR=data/ner_onnx
NER_ONNX_FILE=model_quantized.onnx
# In-memory content-hash cache; 0 disables it. Never persisted.
NER_CACHE_TTL_SECONDS=300
NER_CACHE_MAX_ENTRIES=512
EVAL_RECALL_FLOOR=0.85
FEE_USD_PER_1K_TOKENS=0.001
CORS_ORIGINS=http://localhost:3000
# Ordered detector packs; each lives in backend/packs/<name>/
DETECTOR_PACKS=["ng"]
AEGIS_DEMO_TOKEN=                            # optional shared demo/deployment guard
AEGIS_TICKET_SECRET=                         # optional SSE ticket HMAC secret; defaults to AEGIS_DEMO_TOKEN
