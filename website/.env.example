# Public API base URL, bundled at build time. Leave empty to disable submissions.
# Example for local development: http://127.0.0.1:8000
# The backend must enable PLAYGROUND_ENABLED and allow the website origin in CORS.
NEXT_PUBLIC_PLAYGROUND_API=

# Existing public site origin setting for sitemap, robots, and security.txt Canonical.
# Set to the verified HTTPS origin when preparing a deployment.
# NEXT_PUBLIC_SITE_URL=
